---
interface RecipeFrontmatter {
  title: string;
  servings?: number | string;
  time?: string;
}

const recipes = await Astro.glob<RecipeFrontmatter>('./recipies/*.md');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Kitchen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,350;0,9..144,400;0,9..144,500;1,9..144,400&family=Inter:wght@400;450;500;600&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --bg: #FAFAF8;
        --text-primary: #191816;
        --text-secondary: #363430;
        --text-muted: #8A857D;
        --border-hairline: #E2DDD5;
        --accent: #B8533B;
        
        --font-serif: 'Fraunces', Georgia, serif;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

        --content-indent: 1.85rem;
      }

      * { 
        box-sizing: border-box; 
        margin: 0;
        padding: 0;
      }

      html {
        background-color: var(--bg);
        color: var(--text-primary);
        font-feature-settings: "cv02", "cv03", "cv04", "cv11", "calt";
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      body {
        background-color: var(--bg);
        color: var(--text-primary);
        font-family: var(--font-sans);
        max-width: 660px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem calc(4rem + env(safe-area-inset-bottom));
        line-height: 1.68;
        font-size: 0.9375rem;
        letter-spacing: -0.012em;
      }

      header {
        margin-bottom: 2rem;
      }

      h1 {
        font-family: var(--font-serif);
        font-optical-sizing: auto;
        font-size: clamp(2rem, 4.5vw, 2.6rem);
        line-height: 1.15;
        letter-spacing: -0.025em;
        font-weight: 350;
        color: var(--text-primary);
      }

      .recipe-index {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--border-hairline);
      }

      .recipe-item {
        position: relative;
        display: grid;
        grid-template-columns: var(--content-indent) 1fr auto;
        align-items: baseline;
        gap: 0.75rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid var(--border-hairline);
        text-decoration: none;
        color: inherit;
        transition: color 0.15s ease;
      }

      .recipe-item:hover {
        color: var(--accent);
      }

      .recipe-item:hover .recipe-title,
      .recipe-item:hover .recipe-num {
        color: var(--accent);
      }

      .recipe-num {
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        font-weight: 450;
        color: var(--text-muted);
        font-variant-numeric: tabular-nums lining-nums;
        transition: color 0.15s ease;
        user-select: none;
      }

      .recipe-title {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        font-weight: 400;
        letter-spacing: -0.015em;
        color: var(--text-primary);
        line-height: 1.35;
        transition: color 0.15s ease;
      }

      .recipe-time {
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        color: var(--text-muted);
        font-variant-numeric: tabular-nums lining-nums;
        white-space: nowrap;
        text-align: right;
      }

      .empty-state {
        padding: 2rem 0;
        color: var(--text-muted);
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Oleksii's Recipes</h1>
    </header>

    <main class="recipe-index">
      {recipes.length === 0 ? (
        <p class="empty-state">No recipes found.</p>
      ) : (
        recipes.map((r, index) => (
          <a href={r.url} class="recipe-item">
            <span class="recipe-num">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="recipe-title">
              {r.frontmatter.title}
            </span>
            {r.frontmatter.time && (
              <span class="recipe-time">
                {r.frontmatter.time}
              </span>
            )}
          </a>
        ))
      )}
    </main>
  </body>
</html>